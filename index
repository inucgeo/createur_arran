/* Accès rapide : profils possibles pour une culture + famille données */
function profilsPour(cultureId, familleId) {
  return PROFILS.filter((p) => p.cultureId === cultureId && p.famille === familleId);
}


/* ============================================================
   TERRES D'ARRAN — Moteur de calcul
   Implémente les formules officielles du Livre du joueur :
   - PV = DV max + Mod. CON
   - Init = valeur de DEX (- bonus DEF armure)
   - DEF = 10 + Mod. DEX (annulé si armure encombrante) + bonus
   - ATK contact   = niveau + Mod. FOR + bonus famille + divers
   - ATK distance  = niveau + Mod. DEX + bonus famille + divers - floor(bonusDEF/2)
   - ATK magique   = niveau + Mod. INT + bonus famille + divers - bonusDEF
   - PC = 2 + Mod. CHA (+2 aventuriers)
   - PM = (niveau + Mod. SAG) x multiplicateur famille
   ============================================================ */

const Engine = (() => {
  function findPeuple(peupleId) {
    return PEUPLES.find((p) => p.id === peupleId) || null;
  }
  function findCulture(peupleId, cultureId) {
    const p = findPeuple(peupleId);
    if (!p) return null;
    return p.cultures.find((c) => c.id === cultureId) || null;
  }
  function findCultureAnyPeuple(cultureId) {
    for (const p of PEUPLES) {
      const c = p.cultures.find((c) => c.id === cultureId);
      if (c) return { peuple: p, culture: c };
    }
    return null;
  }
  function findVoieProfil(voieId) {
    return VOIES_PROFIL.find((v) => v.id === voieId) || null;
  }
  function findArmure(armureId) {
    return ARMURES.find((a) => a.id === armureId) || null;
  }
  function findArme(armeId) {
    return ARMES.find((a) => a.id === armeId) || null;
  }

  /* ---- Résolution du peuple/culture (gère les modes composites) ---- */
  // character.peuple = { mode, peupleId, cultureId, parentA, parentB, cultureChoisieId, atoutChoisi, faiblesseChoisie, traitChoisi }
  function resoudrePeuple(character) {
    const pe = character.peuple || {};
    if (pe.mode === "simple") {
      const peuple = findPeuple(pe.peupleId);
      const culture = peuple ? peuple.cultures.find((c) => c.id === pe.cultureId) : null;
      if (!peuple || !culture) return null;
      const modificateurs = culture.modificateurs || peuple.modificateurs || { atouts: [], faiblesses: [] };
      return {
        mode: "simple",
        nomAffiche: `${peuple.nom} (${culture.nom})`,
        modificateurs,
        trait: culture.trait || peuple.trait || null,
        voiesPeuple: [{ key: `peuple:${peuple.id}`, nom: peuple.voiePeuple.nom, rangs: peuple.voiePeuple.rangs, rangMax: 5 }],
        voiesCulturelles: [{ key: `culture:${culture.id}`, nom: culture.voieCulturelle.nom, rangs: culture.voieCulturelle.rangs, rangMax: 5 }],
        prMax: peuple.prMax || culture.prMax || 5,
      };
    }
    if (pe.mode === "semi_elfe" || pe.mode === "sang_mele") {
      const pA = findPeuple(pe.parentA.peupleId);
      const pB = findPeuple(pe.parentB.peupleId);
      if (!pA || !pB) return null;
      const cultureSrc = findCultureAnyPeuple(pe.cultureChoisieId);
      const nomType = pe.mode === "semi_elfe" ? "Semi-Elfe" : "Sang-mêlé";
      return {
        mode: pe.mode,
        nomAffiche: `${nomType} (${pA.nom} × ${pB.nom})`,
        modificateurs: { atouts: [], faiblesses: [] }, // règle officielle : aucun atout/faiblesse
        trait: null,
        voiesPeuple: [
          { key: `peuple:${pA.id}`, nom: pA.voiePeuple.nom, rangs: pA.voiePeuple.rangs, rangMax: 3 },
          { key: `peuple:${pB.id}`, nom: pB.voiePeuple.nom, rangs: pB.voiePeuple.rangs, rangMax: 3 },
        ],
        voiesCulturelles: cultureSrc ? [{ key: `culture:${cultureSrc.culture.id}`, nom: cultureSrc.culture.voieCulturelle.nom, rangs: cultureSrc.culture.voieCulturelle.rangs, rangMax: 5 }] : [],
        prMax: 5,
      };
    }
    if (pe.mode === "metis") {
      // Deux cultures elfes différentes : une seule voie de peuple elfe (pleine), culture choisie parmi les deux parentes.
      const elfe = findPeuple("elfe");
      const cultureSrc = findCultureAnyPeuple(pe.cultureChoisieId);
      return {
        mode: "metis",
        nomAffiche: `Métis elfe (${cultureSrc ? cultureSrc.culture.nom : "?"})`,
        modificateurs: elfe.modificateurs,
        trait: elfe.trait,
        voiesPeuple: [{ key: `peuple:elfe`, nom: elfe.voiePeuple.nom, rangs: elfe.voiePeuple.rangs, rangMax: 5 }],
        voiesCulturelles: cultureSrc ? [{ key: `culture:${cultureSrc.culture.id}`, nom: cultureSrc.culture.voieCulturelle.nom, rangs: cultureSrc.culture.voieCulturelle.rangs, rangMax: 5 }] : [],
        prMax: 5,
      };
    }
    if (pe.mode === "aberration") {
      const pv = findPeuple("peau_verte");
      const cultureSrc = findCultureAnyPeuple(pe.cultureChoisieId);
      const atouts = pe.atoutChoisi ? [pe.atoutChoisi] : [];
      const faiblesses = pe.faiblesseChoisie ? [pe.faiblesseChoisie] : [];
      return {
        mode: "aberration",
        nomAffiche: `Aberration (${pe.parentA.peupleLabel || ""} × ${pe.parentB.peupleLabel || ""})`,
        modificateurs: { atouts, faiblesses },
        trait: pe.traitChoisi || null,
        voiesPeuple: [{ key: `peuple:peau_verte`, nom: pv.voiePeuple.nom, rangs: pv.voiePeuple.rangs, rangMax: 5 }],
        voiesCulturelles: cultureSrc ? [{ key: `culture:${cultureSrc.culture.id}`, nom: cultureSrc.culture.voieCulturelle.nom, rangs: cultureSrc.culture.voieCulturelle.rangs, rangMax: 5 }] : [],
        prMax: 5,
      };
    }
    return null;
  }

  /* ---- Voies de départ disponibles (3 du profil + peuple + culturelle) ---- */
  function voiesDeDepart(character) {
    const res = [];
    (character.voiesProfilChoisies || []).forEach((vid) => {
      const v = findVoieProfil(vid);
      if (v) res.push({ key: `profil:${vid}`, nom: v.nom, rangs: v.rangs, rangMax: 5, type: "profil" });
    });
    const pres = resoudrePeuple(character);
    if (pres) {
      pres.voiesPeuple.forEach((vp) => res.push({ ...vp, type: "peuple" }));
      pres.voiesCulturelles.forEach((vc) => res.push({ ...vc, type: "culturelle" }));
    }
    return res;
  }

  /* Renvoie la liste de toutes les voies "accessibles" (départ + 30 voies de profil
     pour la progression libre au-delà du niveau 1), avec leur rang atteint actuel. */
  function toutesLesVoiesAvecRang(character) {
    const dep = voiesDeDepart(character);
    const prog = character.progressionVoies || {};
    const byKey = {};
    dep.forEach((v) => (byKey[v.key] = { ...v, rangAtteint: prog[v.key] || 0 }));
    VOIES_PROFIL.forEach((v) => {
      const key = `profil:${v.id}`;
      if (!byKey[key]) byKey[key] = { key, nom: v.nom, rangs: v.rangs, rangMax: 5, type: "profil_libre", rangAtteint: prog[key] || 0 };
    });
    return Object.values(byKey);
  }

  /* ---- Effets actifs (cumul de tous les rangs acquis dans toutes les voies) ---- */
  function effetsActifs(character) {
    const out = [];
    const prog = character.progressionVoies || {};
    const voies = toutesLesVoiesAvecRang(character);
    voies.forEach((v) => {
      const rang = prog[v.key] || 0;
      for (let r = 1; r <= rang; r++) {
        const def = v.rangs[r - 1];
        if (def && def.effets) def.effets.forEach((e) => out.push({ ...e, source: `${v.nom} (rang ${r}) — ${def.nom}` }));
      }
    });
    return out;
  }

  /* ---- Caractéristiques finales ---- */
  function caracsFinales(character) {
    const base = character.caracsBase || {};
    const finales = {};
    CARACS.forEach((c) => (finales[c.id] = base[c.id] || 10));
    const pres = resoudrePeuple(character);
    if (pres && pres.modificateurs) {
      (pres.modificateurs.atouts || []).forEach((a) => (finales[a.carac] += a.value));
      (pres.modificateurs.faiblesses || []).forEach((f) => (finales[f.carac] += f.value));
    }
    effetsActifs(character).forEach((e) => {
      if (e.type === "carac") {
        let carac = e.carac;
        if (carac === "CHOIX") carac = character.caracChoixDepassement || null;
        if (carac && finales[carac] !== undefined) finales[carac] += e.value;
      }
    });
    return finales;
  }

  function modsFinaux(character) {
    const finales = caracsFinales(character);
    const mods = {};
    CARACS.forEach((c) => (mods[c.id] = modFromValeur(finales[c.id])));
    return mods;
  }

  /* ---- Statistiques secondaires ---- */
  function statsSecondaires(character) {
    const niveau = character.niveau || 1;
    const mods = modsFinaux(character);
    const famille = FAMILLES[character.familleId] || null;
    const effets = effetsActifs(character);
    const armure = character.equipement && character.equipement.armureId ? findArmure(character.equipement.armureId) : null;
    const bonusDEFArmure = armure ? armure.bonusDEF : 0;
    const armureEncombrante = armure ? !!armure.encombrante : false;

    function sommeStat(stat) {
      let total = 0;
      const detail = [];
      effets.forEach((e) => {
        if (e.type === "stat" && e.stat === stat) {
          total += e.value;
          detail.push({ value: e.value, source: e.source });
        }
        if (e.type === "statParCarac" && e.stat === stat) {
          const v = mods[e.carac] || 0;
          total += v;
          detail.push({ value: v, source: `${e.source} (Mod. ${e.carac})` });
        }
      });
      return { total, detail };
    }

    // PV — niveau 1 : DV maximal + Mod. CON (règle de création).
    // Niveaux supplémentaires : à chaque niveau, +Mod. CON et soit un jet de DV
    // (mémorisé dans character.pvRolls), soit la moitié du DV (méthode "moyenne").
    const deVie = famille ? famille.deVie : 6;
    const niveauxSupplementaires = Math.max(0, niveau - 1);
    const moitieDV = Math.ceil(deVie / 2);
    let pvParNiveauDetail = [];
    let pvProgression = 0;
    if (niveauxSupplementaires > 0) {
      const methode = character.methodePV || "moyenne";
      const rolls = character.pvRolls || [];
      for (let i = 0; i < niveauxSupplementaires; i++) {
        const jet = methode === "aleatoire" ? (rolls[i] !== undefined ? rolls[i] : moitieDV) : moitieDV;
        pvProgression += jet + mods.CON;
        pvParNiveauDetail.push({ niveau: i + 2, de: jet, mod: mods.CON });
      }
    }
    const pvBonus = sommeStat("PV");
    const pv = deVie + mods.CON + pvProgression + pvBonus.total;

    // Initiative
    const initBonus = sommeStat("INIT");
    const initiative = caracsFinales(character).DEX + initBonus.total - bonusDEFArmure;

    // Défense
    const defBonus = sommeStat("DEF");
    const modDEXpourDEF = armureEncombrante ? 0 : mods.DEX;
    const defense = 10 + modDEXpourDEF + bonusDEFArmure + defBonus.total;

    // Scores d'attaque
    const atkContactBonus = sommeStat("ATK_CONTACT");
    const atkDistanceBonus = sommeStat("ATK_DISTANCE");
    const atkMagiqueBonus = sommeStat("ATK_MAGIQUE");
    const bonusFamilleContact = famille ? famille.bonusAttaqueContact : 0;
    const bonusFamilleDistance = famille ? famille.bonusAttaqueDistance : 0;
    const bonusFamilleMagique = famille ? famille.bonusAttaqueMagique : 0;

    const attaqueContact = niveau + mods.FOR + bonusFamilleContact + atkContactBonus.total;
    const attaqueDistanceBrute = niveau + mods.DEX + bonusFamilleDistance + atkDistanceBonus.total;
    const attaqueMagiqueBrute = niveau + mods.INT + bonusFamilleMagique + atkMagiqueBonus.total;
    const malusDistance = Math.floor(bonusDEFArmure / 2);
    const attaqueDistance = attaqueDistanceBrute - malusDistance;
    const attaqueMagique = attaqueMagiqueBrute - bonusDEFArmure;

    // Points de chance
    const pc = 2 + mods.CHA + (famille ? famille.bonusPC : 0);

    // Points de magie
    let pm = (niveau + mods.SAG) * (famille ? famille.multiplicateurPM : 1);
    effets.forEach((e) => {
      if (e.type === "PM_flat_carac") pm += mods[e.carac] || 0;
    });

    // Points de récupération
    const pres = resoudrePeuple(character);
    const prMax = (pres && pres.prMax) || 5;

    return {
      pv, deVie, modCON: mods.CON, pvBonus, moitieDV, pvParNiveauDetail, niveauxSupplementaires,
      initiative, initBonus, bonusDEFArmure,
      defense, defBonus, modDEXpourDEF, armureEncombrante,
      attaqueContact, atkContactBonus,
      attaqueDistance, attaqueDistanceBrute, malusDistance, atkDistanceBonus,
      attaqueMagique, attaqueMagiqueBrute, atkMagiqueBonus,
      pc, pm, prMax,
      malusTestsDEX: bonusDEFArmure,
      bruleMagieRatio: famille ? famille.bruleMagieRatio : 1,
    };
  }

  return {
    findPeuple, findCulture, findCultureAnyPeuple, findVoieProfil, findArmure, findArme,
    resoudrePeuple, voiesDeDepart, toutesLesVoiesAvecRang, effetsActifs,
    caracsFinales, modsFinaux, statsSecondaires,
  };
})();


/* ============================================================
   TERRES D'ARRAN — Application de création de personnage
   ============================================================ */

const STEP_IDS = ["caracs", "peuple", "profil", "capacites", "equipement", "fiche"];
const STEP_LABELS = {
  caracs: "1. Caractéristiques",
  peuple: "2. Peuple & culture",
  profil: "3. Famille & profil",
  capacites: "4. Capacités",
  equipement: "5. Équipement",
  fiche: "6. Fiche & export",
};

let character = null;
let currentStep = "caracs";

function nouveauPersonnage() {
  return {
    nom: "",
    apparence: "",
    niveau: 1,
    // Répartition libre : 77 points au total, min 8 / max 18 par caractéristique
    caracsBase: { FOR: 12, DEX: 12, CON: 13, INT: 13, SAG: 13, CHA: 14 }, // somme = 77
    methodePV: "moyenne", // "moyenne" ou "aleatoire" — progression des PV au-delà du niveau 1
    pvRolls: [], // jets de DV mémorisés pour les niveaux 2, 3, 4... (méthode aléatoire)
    caracChoixDepassement: null,
    peuple: {
      mode: "simple",
      peupleId: null,
      cultureId: null,
      parentA: { peupleId: null, cultureId: null },
      parentB: { peupleId: null, cultureId: null },
      cultureChoisieId: null,
      atoutChoisi: null,
      faiblesseChoisie: null,
      traitChoisi: null,
    },
    familleId: null,
    profilId: null,
    voiesProfilChoisies: [],
    talentMagiqueId: null,
    formationsMartialesChoisies: [],
    progressionVoies: {},
    equipement: { armeIds: [], armureId: null },
  };
}

const STORAGE_KEY = "terres-arran-createur-v1";

/* Fusionne des données (sauvegarde ou JSON importé) avec un personnage vierge,
   sous-objets compris, et ramène les caractéristiques dans les bornes 8–18. */
function normaliserPersonnage(data) {
  const base = nouveauPersonnage();
  const c = Object.assign(base, data || {});
  c.peuple = Object.assign(nouveauPersonnage().peuple, (data && data.peuple) || {});
  c.equipement = Object.assign({ armeIds: [], armureId: null }, (data && data.equipement) || {});
  c.caracsBase = Object.assign(nouveauPersonnage().caracsBase, (data && data.caracsBase) || {});
  CARACS.forEach((k) => {
    const v = parseInt(c.caracsBase[k.id], 10);
    c.caracsBase[k.id] = isNaN(v) ? 8 : Math.max(8, Math.min(18, v));
  });
  c.progressionVoies = c.progressionVoies || {};
  c.voiesProfilChoisies = c.voiesProfilChoisies || [];
  c.formationsMartialesChoisies = c.formationsMartialesChoisies || [];
  delete c.methodeGeneration;
  delete c.valeursDisponibles;
  return c;
}

function sommeCaracs(c) {
  return CARACS.reduce((s, k) => s + (c.caracsBase[k.id] || 0), 0);
}

function sauvegarder() {
  try { localStorage.setItem(STORAGE_KEY, JSON.stringify({ character, currentStep })); } catch (e) { /* stockage indisponible */ }
}

function nouveauDepart() {
  if (!confirm("Effacer le personnage en cours et repartir de zéro ? Pensez à l'exporter en JSON si vous voulez le conserver.")) return;
  character = nouveauPersonnage();
  goStep("caracs");
}

function init() {
  character = nouveauPersonnage();
  try {
    const raw = localStorage.getItem(STORAGE_KEY);
    if (raw) {
      const saved = JSON.parse(raw);
      character = normaliserPersonnage(saved.character);
      if (STEP_IDS.includes(saved.currentStep)) currentStep = saved.currentStep;
    }
  } catch (e) { character = nouveauPersonnage(); }
  renderAll();
}

function renderAll() {
  renderStepsNav();
  renderStep();
  renderSheet();
  sauvegarder();
}

/* ---------------------------------------------------------- */
/* Navigation                                                  */
/* ---------------------------------------------------------- */
function renderStepsNav() {
  const nav = document.getElementById("steps-nav");
  nav.innerHTML = "";
  STEP_IDS.forEach((id) => {
    const b = document.createElement("button");
    b.textContent = STEP_LABELS[id];
    if (id === currentStep) b.classList.add("active");
    b.addEventListener("click", () => {
      currentStep = id;
      renderAll();
      window.scrollTo({ top: 0, behavior: "smooth" });
    });
    nav.appendChild(b);
  });
}

function goStep(id) {
  currentStep = id;
  renderAll();
  window.scrollTo({ top: 0, behavior: "smooth" });
}

/* ---------------------------------------------------------- */
/* Rendu de l'étape courante                                   */
/* ---------------------------------------------------------- */
function renderStep() {
  const c = document.getElementById("step-content");
  c.innerHTML = "";
  if (currentStep === "caracs") c.appendChild(renderStepCaracs());
  else if (currentStep === "peuple") c.appendChild(renderStepPeuple());
  else if (currentStep === "profil") c.appendChild(renderStepProfil());
  else if (currentStep === "capacites") c.appendChild(renderStepCapacites());
  else if (currentStep === "equipement") c.appendChild(renderStepEquipement());
  else if (currentStep === "fiche") c.appendChild(renderStepFiche());
}

function el(tag, attrs, children) {
  const e = document.createElement(tag);
  if (attrs) Object.entries(attrs).forEach(([k, v]) => {
    if (k === "class") e.className = v;
    else if (k === "html") e.innerHTML = v;
    else if (k.startsWith("on")) e.addEventListener(k.slice(2), v);
    else if (k === "disabled" || k === "checked" || k === "selected") {
      if (v) e.setAttribute(k, k);
      else e.removeAttribute(k);
    } else e.setAttribute(k, v);
  });
  (children || []).forEach((ch) => { if (ch) e.appendChild(typeof ch === "string" ? document.createTextNode(ch) : ch); });
  return e;
}

/* ---------------------------------------------------------- */
/* Étape 1 — Caractéristiques                                  */
/* ---------------------------------------------------------- */
function rollerDV(deVie) {
  return 1 + Math.floor(Math.random() * deVie);
}

function ensurePvRolls(character) {
  const famille = character.familleId ? FAMILLES[character.familleId] : null;
  if (!famille) return;
  if (!character.pvRolls) character.pvRolls = [];
  const needed = Math.max(0, (character.niveau || 1) - 1);
  while (character.pvRolls.length < needed) {
    character.pvRolls.push(rollerDV(famille.deVie));
  }
}

function renderStepCaracs() {
  const TOTAL = 77, MIN = 8, MAX = 18;
  const wrap = el("div", { class: "panel" });
  wrap.appendChild(el("h2", {}, ["Caractéristiques"]));

  // Niveau du personnage (inchangé)
  const champNiveau = el("div", { class: "field" }, [
    el("label", {}, ["Niveau du personnage"]),
    (() => {
      const sel = el("select", { onchange: (e) => { character.niveau = parseInt(e.target.value, 10); renderAll(); } });
      for (let n = 1; n <= PROGRESSION.niveauMax; n++) {
        const o = el("option", { value: n }, [`Niveau ${n}`]);
        if (n === character.niveau) o.setAttribute("selected", "selected");
        sel.appendChild(o);
      }
      return sel;
    })(),
    el("div", { class: "hint" }, ["Un personnage débute au niveau 1. Modifiez ce champ pour préparer un personnage déjà expérimenté (les scores d'attaque, PV et PM en tiennent compte automatiquement)."]),
  ]);
  wrap.appendChild(champNiveau);

  // Calcul des points dépensés / restants
  const totalDepense = CARACS.reduce((s, c) => s + (character.caracsBase[c.id] || MIN), 0);
  const restants = TOTAL - totalDepense;

  // Compteur de points
  const compteurMsg = restants === 0
    ? "✓ Les 77 points sont entièrement répartis."
    : restants > 0
      ? `Il reste ${restants} point${restants > 1 ? "s" : ""} à distribuer (sur 77).`
      : `⚠ Total dépassé de ${-restants} point${-restants > 1 ? "s" : ""} — réduisez certaines caractéristiques.`;
  wrap.appendChild(el("div", { class: restants === 0 ? "info-box" : "warning-box" }, [compteurMsg]));

  wrap.appendChild(el("div", { class: "hint" }, [
    `Répartissez librement 77 points entre les six caractéristiques. Chaque score est compris entre ${MIN} (minimum) et ${MAX} (maximum).`
  ]));

  // Tableau des caractéristiques avec steppers −  valeur  +
  const table = el("div", {});
  CARACS.forEach((c) => {
    const val = Math.max(MIN, Math.min(MAX, character.caracsBase[c.id] || MIN));
    const mod = modFromValeur(val);
    const row = el("div", { class: "carac-row" });

    // Colonne 1 : nom
    row.appendChild(el("div", { class: "nom" }, [`${c.nom} (${c.id})`]));

    // Colonne 2 : stepper  − valeur +
    const stepper = el("div", { style: "display:flex;align-items:center;gap:0.35rem;" });
    const btnMoins = el("button", {
      class: "btn secondary",
      style: "padding:0.1rem 0.55rem;font-size:1rem;line-height:1.4;",
      disabled: val <= MIN,
      onclick: () => { character.caracsBase[c.id] = val - 1; renderAll(); },
    }, ["−"]);
    const valSpan = el("span", {
      style: "min-width:1.8rem;text-align:center;font-family:Georgia,serif;font-size:1.05rem;font-weight:700;",
    }, [String(val)]);
    const btnPlus = el("button", {
      class: "btn secondary",
      style: "padding:0.1rem 0.55rem;font-size:1rem;line-height:1.4;",
      disabled: val >= MAX || restants <= 0,
      onclick: () => { character.caracsBase[c.id] = val + 1; renderAll(); },
    }, ["+"]);
    stepper.appendChild(btnMoins);
    stepper.appendChild(valSpan);
    stepper.appendChild(btnPlus);
    row.appendChild(stepper);

    // Colonne 3 : modificateur
    row.appendChild(el("div", { class: "mod " + (mod > 0 ? "pos" : mod < 0 ? "neg" : "") }, [(mod >= 0 ? "+" : "") + mod]));

    // Colonne 4 : description
    row.appendChild(el("div", { class: "hint" }, [c.description]));

    table.appendChild(row);
  });
  wrap.appendChild(table);

  // Bouton de réinitialisation à la répartition équilibrée (77 pts)
  const btnReset = el("button", {
    class: "btn secondary",
    style: "margin-top:0.8rem;",
    onclick: () => { character.caracsBase = { FOR: 12, DEX: 12, CON: 13, INT: 13, SAG: 13, CHA: 14 }; renderAll(); },
  }, ["↺ Réinitialiser la répartition"]);
  wrap.appendChild(btnReset);

  wrap.appendChild(el("div", { class: "hint" }, [
    "Le modificateur est calculé sur la valeur de base, avant les modificateurs raciaux appliqués à l'étape suivante."
  ]));

  const btnContinuer = el("button", {
    class: "btn",
    disabled: restants !== 0,
    onclick: () => goStep("peuple"),
  }, ["Continuer →"]);
  wrap.appendChild(el("div", { class: "btn-row" }, [btnContinuer]));

  return wrap;
}

