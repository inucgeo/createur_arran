  box.appendChild(statTable);
  box.appendChild(el("div", { class: "hint" }, [
    `Brûlure de magie : 1 PM = ${s.bruleMagieRatio} PV. Malus d'encombrement appliqué : DEF ${s.armureEncombrante ? "(bonus de DEX annulé) " : ""}, Initiative -${s.bonusDEFArmure}, Attaque à distance -${s.malusDistance}, Attaque magique -${s.bonusDEFArmure}, tests de DEX -${s.malusTestsDEX}.`,
  ]));
  if (s.niveauxSupplementaires > 0) {
    const methLabel = character.methodePV === "aleatoire" ? "jets de DV mémorisés" : "moitié du DV (méthode forfaitaire)";
    box.appendChild(el("div", { class: "hint" }, [
      `Progression des PV (${methLabel}) : ${s.pvParNiveauDetail.map((d) => `niveau ${d.niveau} +${d.de + d.mod}`).join(", ")}.`,
    ]));
  }

  box.appendChild(el("div", { class: "divider" }));
  box.appendChild(el("h3", {}, ["Formations martiales"]));
  box.appendChild(el("p", {}, [["Armes de paysan", ...character.formationsMartialesChoisies.map((c) => CATEGORIES_EQUIPEMENT.find((x) => x.id === c).nom)].join(", ")]));

  if (character.talentMagiqueId) {
    const tal = TALENTS_MAGIQUES.find((t) => t.id === character.talentMagiqueId);
    box.appendChild(el("h3", {}, ["Talent magique"]));
    box.appendChild(el("p", {}, [el("strong", {}, [tal.nom + " — "]), tal.texte]));
  }

  box.appendChild(el("div", { class: "divider" }));
  box.appendChild(el("h3", {}, ["Capacités acquises"]));
  const voies = Engine.toutesLesVoiesAvecRang(character);
  let auMoinsUne = false;
  voies.forEach((v) => {
    const rang = (character.progressionVoies || {})[v.key] || 0;
    if (rang <= 0) return;
    auMoinsUne = true;
    box.appendChild(el("h4", {}, [v.nom]));
    for (let r = 1; r <= rang; r++) {
      const cap = v.rangs[r - 1];
      box.appendChild(el("div", { class: "capacite-rang acquise" }, [
        el("div", {}, [el("span", { class: "rang-num" }, [`R${r}`]), el("span", { class: "nom-cap" }, [cap.nom])]),
        el("div", { class: "txt" }, [cap.texte]),
      ]));
    }
  });
  if (!auMoinsUne) box.appendChild(el("p", { class: "hint" }, ["Aucune capacité choisie pour le moment."]));

  box.appendChild(el("div", { class: "divider" }));
  box.appendChild(el("h3", {}, ["Équipement"]));
  const armeNoms = character.equipement.armeIds.map((id) => Engine.findArme(id)).filter(Boolean).map((a) => `${a.nom} (DM ${a.dm}${a.mod && a.mod !== "-" ? "+Mod." + a.mod : ""})`);
  box.appendChild(el("p", {}, [el("strong", {}, ["Armes : "]), armeNoms.length ? armeNoms.join(", ") : "aucune"]));
  const armure = character.equipement.armureId ? Engine.findArmure(character.equipement.armureId) : null;
  box.appendChild(el("p", {}, [el("strong", {}, ["Armure : "]), armure ? `${armure.nom} (DEF +${armure.bonusDEF})` : "aucune"]));
  box.appendChild(el("p", {}, [el("strong", {}, ["Sac d'aventurier : "]), "couverture, torche, briquet à silex, outre, gamelle, bourse de 5 po."]));

  return box;
}

/* ---------------------------------------------------------- */
/* Export / Import JSON                                         */
/* ---------------------------------------------------------- */
function exporterJSON() {
  const data = JSON.stringify(character, null, 2);
  const blob = new Blob([data], { type: "application/json" });
  const url = URL.createObjectURL(blob);
  const a = document.createElement("a");
  a.href = url;
  a.download = `${(character.nom || "personnage").replace(/[^a-z0-9_-]+/gi, "_")}_terres_arran.json`;
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
  URL.revokeObjectURL(url);
}

function importerJSON(evt) {
  const file = evt.target.files && evt.target.files[0];
  if (!file) return;
  const reader = new FileReader();
  reader.onload = () => {
    try {
      const data = JSON.parse(reader.result);
      character = normaliserPersonnage(data);
      const total = sommeCaracs(character);
      if (total !== 77) {
        currentStep = "caracs";
        alert(`Personnage importé. Ses caractéristiques totalisent ${total} points (création selon une ancienne règle) : ajustez-les à l'étape 1 pour atteindre 77.`);
      }
      renderAll();
    } catch (e) {
      alert("Le fichier sélectionné n'est pas un personnage Terres d'Arran valide.");
    }
  };
  reader.readAsText(file);
  evt.target.value = "";
}

/* ---------------------------------------------------------- */
/* Panneau latéral — fiche en direct                            */
/* ---------------------------------------------------------- */
function renderSheet() {
  const panel = document.getElementById("sheet-content");
  panel.innerHTML = "";

  panel.appendChild(el("div", { class: "nom-perso" }, [character.nom || "Personnage sans nom"]));
  const pres = Engine.resoudrePeuple(character);
  const famille = character.familleId ? FAMILLES[character.familleId] : null;
  const profil = character.profilId ? PROFILS.find((p) => p.id === character.profilId) : null;
  panel.appendChild(el("div", { class: "sous-titre" }, [
    `Niveau ${character.niveau}${pres ? " — " + pres.nomAffiche : ""}${famille ? " — " + famille.nom : ""}${profil ? " (" + profil.nom + ")" : ""}`,
  ]));

  const caracsF = Engine.caracsFinales(character);
  const mods = Engine.modsFinaux(character);
  const miniCaracs = el("div", { class: "mini-caracs" });
  CARACS.forEach((c) => {
    miniCaracs.appendChild(el("div", { class: "mini-carac" }, [
      el("div", { class: "k" }, [c.id]),
      el("div", { class: "v" }, [String(caracsF[c.id])]),
      el("div", { class: "m" }, [(mods[c.id] >= 0 ? "+" : "") + mods[c.id]]),
    ]));
  });
  panel.appendChild(miniCaracs);

  const s = Engine.statsSecondaires(character);
  const statGrid = el("div", { class: "stat-grid" });
  const sb = (label, value) => el("div", { class: "stat-box" }, [el("div", { class: "label" }, [label]), el("div", { class: "value" }, [String(value)])]);
  statGrid.appendChild(sb("PV", s.pv));
  statGrid.appendChild(sb("DEF", s.defense));
  statGrid.appendChild(sb("Initiative", s.initiative));
  statGrid.appendChild(sb("PC", s.pc));
  statGrid.appendChild(sb("Atq. contact", (s.attaqueContact >= 0 ? "+" : "") + s.attaqueContact));
  statGrid.appendChild(sb("Atq. distance", (s.attaqueDistance >= 0 ? "+" : "") + s.attaqueDistance));
  statGrid.appendChild(sb("Atq. magique", (s.attaqueMagique >= 0 ? "+" : "") + s.attaqueMagique));
  statGrid.appendChild(sb("PM", s.pm));
  panel.appendChild(statGrid);

  const voies = Engine.toutesLesVoiesAvecRang(character);
  const capacitesListe = [];
  voies.forEach((v) => {
    const rang = (character.progressionVoies || {})[v.key] || 0;
    for (let r = 1; r <= rang; r++) capacitesListe.push(`${v.rangs[r - 1].nom} (${v.nom} R${r})`);
  });
  if (capacitesListe.length) {
    panel.appendChild(el("h3", {}, ["Capacités"]));
    const ul = el("ul", { class: "liste-simple" });
    capacitesListe.forEach((t) => ul.appendChild(el("li", {}, [t])));
    panel.appendChild(ul);
  }

  if (character.equipement.armeIds.length || character.equipement.armureId) {
    panel.appendChild(el("h3", {}, ["Équipement"]));
    const ul = el("ul", { class: "liste-simple" });
    character.equipement.armeIds.forEach((id) => { const a = Engine.findArme(id); if (a) ul.appendChild(el("li", {}, [a.nom])); });
    if (character.equipement.armureId) { const a = Engine.findArmure(character.equipement.armureId); if (a) ul.appendChild(el("li", {}, [`${a.nom} (DEF +${a.bonusDEF})`])); }
    panel.appendChild(ul);
  }
}

window.addEventListener("DOMContentLoaded", init);

