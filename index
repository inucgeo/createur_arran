        faiblessesParents.forEach((f, i) => sel.appendChild(el("option", { value: i }, [`${f.value} ${f.carac}`])));
        return sel;
      })(),
    ]));
    const traits = [cA.culture.trait || cA.peuple.trait, cB.culture.trait || cB.peuple.trait].filter(Boolean);
    box.appendChild(el("div", { class: "field" }, [
      el("label", {}, ["Trait (au choix parmi ceux des parents)"]),
      (() => {
        const sel = el("select", { onchange: (e) => { const i = parseInt(e.target.value, 10); character.peuple.traitChoisi = isNaN(i) ? null : traits[i]; renderAll(); } });
        sel.appendChild(el("option", { value: "" }, ["— Aucun —"]));
        traits.forEach((t, i) => sel.appendChild(el("option", { value: i }, [t.nom])));
        return sel;
      })(),
    ]));
  }
  return box;
}

