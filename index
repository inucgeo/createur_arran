<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>Les Terres d'Arran — Créateur de personnage</title>
<style>
:root {
  --parchment: #ECE2C6;
  --parchment-deep: #E0D2A8;
  --panel: #F6EFD9;
  --ink: #2A2018;
  --ink-soft: #5B4D38;
  --gold: #8C6A24;
  --gold-soft: #C7A55A;
  --crimson: #7A2E2E;
  --teal: #2F6B66;
  --line: #C9B47E;
  --shadow: 0 2px 8px rgba(42, 32, 24, 0.18);
  --radius: 6px;
  font-size: 16px;
}

* { box-sizing: border-box; }

html, body {
  margin: 0;
  padding: 0;
  background: var(--parchment);
  color: var(--ink);
  font-family: "Segoe UI", "Helvetica Neue", Arial, sans-serif;
  line-height: 1.5;
}

h1, h2, h3, h4 {
  font-family: Georgia, "Iowan Old Style", "Times New Roman", serif;
  color: var(--gold);
  margin: 0 0 0.4em 0;
  font-weight: normal;
}

h1 { font-size: 1.7rem; letter-spacing: 0.02em; }
h2 { font-size: 1.25rem; border-bottom: 2px solid var(--line); padding-bottom: 0.3em; margin-bottom: 0.7em; }
h3 { font-size: 1.05rem; color: var(--ink-soft); }

a { color: var(--teal); }

#app {
  max-width: 1280px;
  margin: 0 auto;
  padding: 1.2rem;
}

header.top {
  display: flex;
  align-items: center;
  gap: 1rem;
  margin-bottom: 1.2rem;
  padding-bottom: 0.8rem;
  border-bottom: 3px double var(--gold-soft);
}

header.top .seal {
  width: 46px; height: 46px;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 30%, #F6EFD9, var(--gold-soft) 70%, var(--gold) 100%);
  border: 2px solid var(--gold);
  display: flex; align-items: center; justify-content: center;
  font-family: Georgia, serif;
  font-weight: bold; color: var(--ink);
  flex-shrink: 0;
}

header.top .titles h1 { margin: 0; }
header.top .titles .subtitle { color: var(--ink-soft); font-size: 0.85rem; }

.layout {
  display: grid;
  grid-template-columns: minmax(0, 1.6fr) minmax(280px, 1fr);
  gap: 1.4rem;
  align-items: start;
}

@media (max-width: 920px) {
  .layout { grid-template-columns: 1fr; }
  .sheet-panel { position: static !important; }
}

.steps-nav {
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
  margin-bottom: 1rem;
}

.steps-nav button {
  border: 1px solid var(--line);
  background: var(--panel);
  color: var(--ink-soft);
  padding: 0.35rem 0.7rem;
  border-radius: 999px;
  font-size: 0.78rem;
  cursor: pointer;
  font-family: inherit;
}
.steps-nav button.active {
  background: var(--gold);
  color: #fff;
  border-color: var(--gold);
  font-weight: 600;
}
.steps-nav button:disabled { opacity: 0.45; cursor: not-allowed; }

.panel {
  background: var(--panel);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  padding: 1.1rem 1.3rem;
  margin-bottom: 1rem;
}

.divider {
  height: 1px;
  margin: 1rem 0;
  background: linear-gradient(to right, transparent, var(--gold-soft), transparent);
}

.field { margin-bottom: 0.9rem; }
.field label { display: block; font-weight: 600; margin-bottom: 0.25rem; color: var(--ink-soft); font-size: 0.92rem; }
.hint { font-size: 0.82rem; color: var(--ink-soft); }
.field .hint { font-size: 0.8rem; color: var(--ink-soft); margin-top: 0.2rem; }

input[type="text"], input[type="number"], select, textarea {
  width: 100%;
  padding: 0.45rem 0.55rem;
  border: 1px solid var(--line);
  border-radius: 4px;
  background: #fff;
  font-family: inherit;
  font-size: 0.95rem;
  color: var(--ink);
}
textarea { min-height: 70px; resize: vertical; }

.btn {
  display: inline-block;
  background: var(--gold);
  color: #fff;
  border: none;
  padding: 0.55rem 1.1rem;
  border-radius: 4px;
  cursor: pointer;
  font-family: inherit;
  font-size: 0.92rem;
  font-weight: 600;
}
.btn:hover { background: var(--ink-soft); }
.btn.secondary { background: transparent; color: var(--gold); border: 1px solid var(--gold); }
.btn.secondary:hover { background: var(--gold); color: #fff; }
.btn:disabled { opacity: 0.5; cursor: not-allowed; }
.btn-row { display: flex; gap: 0.6rem; margin-top: 1rem; flex-wrap: wrap; }

.grid-2 { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.8rem; }
.grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.8rem; }
@media (max-width: 600px) { .grid-2, .grid-3 { grid-template-columns: 1fr; } }

.carac-row {
  display: grid;
  grid-template-columns: 1.3fr 1fr 0.6fr 1.6fr;
  gap: 0.6rem;
  align-items: center;
  padding: 0.4rem 0;
  border-bottom: 1px solid var(--line);
}
.carac-row:last-child { border-bottom: none; }
.carac-row .nom { font-weight: 600; }
.carac-row .mod { text-align: center; font-family: Georgia, serif; font-size: 1.1rem; }
.carac-row .mod.pos { color: var(--teal); }
.carac-row .mod.neg { color: var(--crimson); }
@media (max-width: 600px) {
  .carac-row { grid-template-columns: 1fr auto auto; }
  .carac-row > .hint { grid-column: 1 / -1; }
}

.tag {
  display: inline-block;
  background: var(--parchment-deep);
  border: 1px solid var(--line);
  border-radius: 999px;
  padding: 0.15rem 0.6rem;
  font-size: 0.76rem;
  margin: 0.1rem 0.2rem 0.1rem 0;
  color: var(--ink-soft);
}

.culture-card, .archetype-card, .voie-card {
  border: 1px solid var(--line);
  border-radius: var(--radius);
  background: #fff;
  padding: 0.7rem 0.9rem;
  margin-bottom: 0.6rem;
  cursor: pointer;
  transition: box-shadow 0.15s;
}
.culture-card:hover, .archetype-card:hover, .voie-card:hover { box-shadow: var(--shadow); }
.culture-card.selected, .archetype-card.selected, .voie-card.selected {
  border-color: var(--gold);
  background: #FFFBF0;
  box-shadow: 0 0 0 2px var(--gold-soft) inset;
}
.culture-card h4, .archetype-card h4, .voie-card h4 { margin: 0 0 0.25rem 0; color: var(--ink); font-family: Georgia, serif; }
.culture-card .flavor, .archetype-card .desc { font-size: 0.84rem; color: var(--ink-soft); margin: 0.2rem 0; }

.capacite-rang {
  border-left: 3px solid var(--line);
  padding: 0.4rem 0.7rem;
  margin-bottom: 0.4rem;
  background: #fff;
  border-radius: 0 4px 4px 0;
}
.capacite-rang.acquise { border-left-color: var(--teal); background: #F2F8F6; }
.capacite-rang.selectable { cursor: pointer; }
.capacite-rang.selectable:hover { background: #FFF8E8; }
.capacite-rang .rang-num { font-weight: 700; color: var(--gold); margin-right: 0.4rem; }
.capacite-rang .nom-cap { font-weight: 600; }
.capacite-rang .txt { font-size: 0.84rem; color: var(--ink-soft); margin-top: 0.15rem; }
.capacite-rang .effet-badge { display: inline-block; font-size: 0.7rem; color: var(--teal); border: 1px solid var(--teal); border-radius: 4px; padding: 0 0.3rem; margin-left: 0.4rem; }

/* ---- Sheet panel ---- */
.sheet-panel { position: sticky; top: 1rem; }
.sheet {
  background: var(--panel);
  border: 1px solid var(--gold-soft);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  padding: 1rem 1.1rem;
}
.sheet h2 { font-size: 1.1rem; }
.sheet .nom-perso { font-family: Georgia, serif; font-size: 1.3rem; color: var(--ink); margin-bottom: 0.2rem; }
.sheet .sous-titre { color: var(--ink-soft); font-size: 0.85rem; margin-bottom: 0.8rem; }

.stat-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; margin-bottom: 0.8rem; }
.stat-box {
  background: #fff;
  border: 1px solid var(--line);
  border-radius: 4px;
  padding: 0.4rem 0.5rem;
  text-align: center;
}
.stat-box .label { font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--ink-soft); }
.stat-box .value { font-family: Georgia, serif; font-size: 1.25rem; color: var(--ink); }
.stat-box.wide { grid-column: span 2; }

.mini-caracs { display: grid; grid-template-columns: repeat(6, 1fr); gap: 0.3rem; margin-bottom: 0.8rem; }
.mini-carac { text-align: center; background: #fff; border: 1px solid var(--line); border-radius: 4px; padding: 0.3rem 0.1rem; }
.mini-carac .k { font-size: 0.68rem; color: var(--ink-soft); }
.mini-carac .v { font-family: Georgia, serif; font-size: 1.05rem; }
.mini-carac .m { font-size: 0.78rem; color: var(--teal); }

.sheet ul.liste-simple { list-style: none; margin: 0; padding: 0; font-size: 0.85rem; }
.sheet ul.liste-simple li { padding: 0.15rem 0; border-bottom: 1px dashed var(--line); }

.warning-box {
  background: #FBEDEA;
  border: 1px solid var(--crimson);
  color: var(--crimson);
  border-radius: 4px;
  padding: 0.5rem 0.7rem;
  font-size: 0.82rem;
  margin-bottom: 0.7rem;
}
.info-box {
  background: #EAF3F2;
  border: 1px solid var(--teal);
  color: var(--ink);
  border-radius: 4px;
  padding: 0.5rem 0.7rem;
  font-size: 0.82rem;
  margin-bottom: 0.7rem;
}

footer.app-footer { text-align: center; color: var(--ink-soft); font-size: 0.78rem; margin-top: 2rem; padding-top: 1rem; border-top: 1px solid var(--line); }

/* ---- Print ---- */
@media print {
  body * { visibility: hidden; }
  #print-sheet, #print-sheet * { visibility: visible; }
  #print-sheet {
    position: absolute; top: 0; left: 0; width: 100%;
    background: #fff; color: #000; padding: 0;
  }
  .no-print { display: none !important; }
}

</style>
</head>
<body>
<div id="app">
  <header class="top">
    <div class="seal">TA</div>
    <div class="titles">
      <h1>Les Terres d'Arran</h1>
      <div class="subtitle">Créateur de personnage — calcul automatique des caractéristiques, capacités et statistiques</div>
    </div>
  </header>

  <div class="steps-nav no-print" id="steps-nav"></div>

  <div class="layout">
    <div id="step-content"></div>
    <div class="sheet-panel no-print">
      <div class="sheet" id="sheet-content"></div>
    </div>
  </div>

  <footer class="app-footer no-print">
    Outil non officiel à usage privé, réalisé à partir du Livre du joueur des Terres d'Arran (© Black Book Éditions). Règle maison : répartition libre de 77 points (8 à 18) au lieu des méthodes du livre. La création en cours est enregistrée dans ce navigateur. Trente voies de profil (cent cinquante capacités), seize cultures et cinquante-et-un profils archétypaux sont intégrés. Les voies de prestige (à partir du niveau 8) ne sont pas encore détaillées dans cette version.
  </footer>
</div>

<script>
/* ============================================================
   TERRES D'ARRAN — Données de base
   Source : Livre du joueur, chapitre 2 "La création de personnage"
   ============================================================ */

const CARACS = [
  { id: "FOR", nom: "Force", description: "Mesure la puissance physique et musculaire. Gagner un bras de fer, soulever, tordre, lancer un objet lourd, immobiliser un adversaire. Détermine la capacité à porter des attaques de contact et à blesser." },
  { id: "DEX", nom: "Dextérité", description: "Évalue l'agilité, les réflexes et l'adresse. Faire des acrobaties, tenir en équilibre, grimper, sauter, sprinter, se déplacer en silence, crocheter, chaparder. Détermine la capacité à porter des attaques à distance, à éviter les coups et la vivacité en combat." },
  { id: "CON", nom: "Constitution", description: "Représente la santé et l'endurance. Résister aux éléments, à la fatigue, aux poisons, aux privations, courir longtemps. Détermine la capacité à encaisser des blessures et à en guérir." },
  { id: "INT", nom: "Intelligence", description: "Représente les capacités d'apprentissage et de raisonnement. Raisonner, comprendre, connaître, apprendre, se souvenir, chercher, trouver une information. Détermine l'efficacité avec laquelle le personnage lance ses sorts et leur puissance." },
  { id: "SAG", nom: "Sagesse", description: "Relie le personnage à l'univers : volonté, intuition, perception. Observer, entendre, détecter, repérer, pister, deviner, ressentir, résister à la peur ou aux influences mentales. Détermine la quantité de sorts pouvant être lancés ainsi que leur durée." },
  { id: "CHA", nom: "Charisme", description: "Traduit la force de persuasion, la présence et la capacité à commander. Bluffer, mentir, négocier, séduire, intimider, convaincre. Détermine également la chance du personnage." },
];

/* Table 1 : valeur de Carac. -> modificateur (Livre du joueur, p.41) */
function modFromValeur(valeur) {
  if (valeur <= 3) return -4;
  if (valeur <= 5) return -3;
  if (valeur <= 7) return -2;
  if (valeur <= 9) return -1;
  if (valeur <= 11) return 0;
  if (valeur <= 13) return 1;
  if (valeur <= 15) return 2;
  if (valeur <= 17) return 3;
  if (valeur <= 19) return 4;
  if (valeur <= 21) return 5;
  // au-delà de 21, on continue la progression par paliers de 2
  return 5 + Math.ceil((valeur - 21) / 2);
}

/* Familles de profil — Livre du joueur p.44 */
const FAMILLES = {
  combattant: {
    id: "combattant",
    nom: "Combattant",
    deVie: 10,
    formationsMartiales: 3,
    bonusAttaqueContact: 2,
    bonusAttaqueDistance: 2,
    bonusAttaqueMagique: 0,
    bruleMagieRatio: 2, // 1 PM = 2 PV
    bonusPC: 0,
    multiplicateurPM: 1,
    talentMagiqueRequis: false,
    description: "Force brute, art de la guerre et combat. La Force et la Constitution sont les caractéristiques privilégiées. Brûlure de magie doublée (1 PM = 2 PV).",
  },
  aventurier: {
    id: "aventurier",
    nom: "Aventurier",
    deVie: 8,
    formationsMartiales: 2,
    bonusAttaqueContact: 1,
    bonusAttaqueDistance: 1,
    bonusAttaqueMagique: 0,
    bruleMagieRatio: 1,
    bonusPC: 2,
    multiplicateurPM: 1,
    talentMagiqueRequis: false,
    description: "Voyage, exploration, discrétion et aptitudes sociales. La Dextérité et le Charisme sont privilégiés. Bonus de +2 aux Points de chance.",
  },
  mystique: {
    id: "mystique",
    nom: "Mystique",
    deVie: 6,
    formationsMartiales: 1,
    bonusAttaqueContact: 0,
    bonusAttaqueDistance: 0,
    bonusAttaqueMagique: 2,
    bruleMagieRatio: 1,
    bonusPC: 0,
    multiplicateurPM: 2, // PM doublés
    talentMagiqueRequis: true,
    description: "Savants, sages et adeptes des forces occultes. L'Intelligence et la Sagesse sont privilégiées. Points de magie doublés et talent magique offert.",
  },
};

/* Talents magiques — Livre du joueur p.44-45 (réservés à la famille des mystiques) */
const TALENTS_MAGIQUES = [
  {
    id: "detection_magie",
    nom: "Détection de la magie",
    texte: "Pour une action d'attaque, le mystique se concentre et détecte la présence de toute inscription, aura ou objet magique situé(e) dans la pièce où il se trouve (ou dans les 15 mètres autour de lui).",
  },
  {
    id: "flamme",
    nom: "Flamme",
    texte: "Pour une action gratuite et tant qu'il le souhaite, le mystique fait apparaître dans la paume de sa main une petite flamme, à peine assez intense pour éclairer une zone dans un rayon de 5 mètres. Il peut l'utiliser pour mettre le feu à des matières inflammables ou porter une attaque de contact — pour une action d'attaque — à un adversaire en utilisant son score d'attaque magique et lui infligeant 1d6 DM.",
  },
  {
    id: "inspiration",
    nom: "Inspiration",
    texte: "Au prix d'une action d'attaque, le mystique désigne un allié à moins de 10 mètres et lui octroie un bonus de +1 à tous ses tests pendant [2 + Mod. SAG] tours. Il peut lancer une inspiration à chaque tour mais ne peut maintenir plus de [1 + Mod. INT] inspirations à la fois (minimum 1).",
  },
  {
    id: "lumieres_dansantes",
    nom: "Lumières dansantes",
    texte: "Au prix d'une action de mouvement, le mystique fait apparaître trois petites sphères de lumière de la couleur de son choix lévitant autour de son corps. Elles éclairent une zone dans un rayon de 20 mètres et persistent aussi longtemps que le mystique le souhaite. Le moindre DM subi rompt la concentration et les fait disparaître.",
  },
  {
    id: "projectile_force",
    nom: "Projectile de force",
    texte: "Pour une action d'attaque, le mystique choisit une cible visible à moins de 50 mètres et projette une onde de choc qui la touche automatiquement, lui infligeant 1d4 DM. Le projectile de force est presque invisible et n'émet aucun son lorsqu'il file dans l'air.",
  },
];

/* Catégories d'armes et armures — Livre du joueur p.44 (simplifié pour la formation martiale) */
const CATEGORIES_EQUIPEMENT = [
  { id: "paysan", nom: "Armes de paysan", type: "arme", gratuite: true, exemples: "bâton, bâton ferré, dague, fronde, mains nues" },
  { id: "guerre", nom: "Armes de guerre", type: "arme", exemples: "épée longue, hache à une main, marteau de guerre, masse d'armes" },
  { id: "guerre_lourde", nom: "Armes de guerre lourdes", type: "arme", exemples: "épée à deux mains, épée bâtarde, hache à deux mains" },
  { id: "hast", nom: "Armes d'hast", type: "arme", exemples: "épieu, pique, lance, lance de cavalerie" },
  { id: "duel", nom: "Armes de duel", type: "arme", exemples: "épée courte, rapière, main gauche" },
  { id: "trait", nom: "Armes de trait", type: "arme", exemples: "arc court, arc composite, arc long" },
  { id: "tir", nom: "Armes de tir", type: "arme", exemples: "arbalète légère, arbalète lourde, arbalète de poing" },
  { id: "jet", nom: "Armes de jet", type: "arme", exemples: "couteau de lancer, hachette, javelot" },
  { id: "legere", nom: "Armures légères", type: "armure", exemples: "petit bouclier, tissu matelassé, armure de cuir, armure de cuir renforcé" },
  { id: "lourde", nom: "Armures lourdes", type: "armure", exemples: "grand bouclier, chemise de mailles, cotte de mailles, demi-plaques" },
];

/* Table officielle des armures — Livre du joueur, chapitre "Équipement" p.159 */
const ARMURES = [
  { id: "petit_bouclier", nom: "Petit bouclier", categorie: "legere", bonusDEF: 1, prix: "2 pa" },
  { id: "tissu_matelasse", nom: "Tissu matelassé", categorie: "legere", bonusDEF: 1, prix: "2 pa" },
  { id: "cuir", nom: "Armure de cuir", categorie: "legere", bonusDEF: 2, prix: "4 pa" },
  { id: "cuir_renforce", nom: "Armure de cuir renforcée", categorie: "legere", bonusDEF: 3, prix: "8 pa" },
  { id: "grand_bouclier", nom: "Grand bouclier", categorie: "lourde", bonusDEF: 2, prix: "4 pa" },
  { id: "mailles", nom: "Chemise de mailles", categorie: "lourde", bonusDEF: 4, prix: "15 pa" },
  { id: "cotte_mailles", nom: "Cotte de mailles", categorie: "lourde", bonusDEF: 5, prix: "20 pa" },
  { id: "demi_plaques", nom: "Demi-plaques", categorie: "lourde", bonusDEF: 6, prix: "50 pa", encombrante: true, note: "Encombrante : annule le bonus de DEX à la DEF." },
  { id: "armure_plaques", nom: "Armure de plaques", categorie: "lourde", bonusDEF: 7, prix: "200 pa", encombrante: true, requisCapacite: "Armure lourde (voie du bastion, rang 5)", note: "Encombrante : annule le bonus de DEX à la DEF. Protège des attaques critiques (DM normaux au lieu de DM doublés)." },
];

/* Table officielle des armes — Livre du joueur, chapitre "Équipement" p.157-158 */
const ARMES = [
  // Armes de paysan (gratuites, maîtrise offerte à tous)
  { id: "baton", nom: "Bâton", categorie: "paysan", dm: "(1d4)", mod: "FOR", prix: "-", note: "DM temporaires" },
  { id: "baton_ferre", nom: "Bâton ferré", categorie: "paysan", dm: "1d6", mod: "FOR", prix: "2 pa" },
  { id: "dague", nom: "Dague", categorie: "paysan", dm: "1d4", mod: "FOR", prix: "3 pa" },
  { id: "fronde", nom: "Fronde", categorie: "paysan", dm: "1d4", mod: "-", portee: "20 m", prix: "-" },
  { id: "mains_nues", nom: "Mains nues", categorie: "paysan", dm: "(1d4)", mod: "FOR", prix: "-", note: "DM temporaires" },
  { id: "grande_hache_bucheron", nom: "Grande hache de bûcheron", categorie: "paysan", dm: "2d4", mod: "FOR", prix: "10 pa", note: "Arme à deux mains. Nécessite une capacité pour être maîtrisée." },
  // Armes de guerre
  { id: "epee_longue", nom: "Épée longue", categorie: "guerre", dm: "1d8", mod: "FOR", prix: "6 pa" },
  { id: "hache_une_main", nom: "Hache à une main", categorie: "guerre", dm: "1d8", mod: "FOR", prix: "6 pa" },
  { id: "marteau_guerre", nom: "Marteau de guerre", categorie: "guerre", dm: "1d6", mod: "FOR", prix: "4 pa" },
  { id: "masse_armes", nom: "Masse d'armes", categorie: "guerre", dm: "1d6", mod: "FOR", prix: "4 pa" },
