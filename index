function renderStepProfil() {
  const wrap = el("div", { class: "panel" });
  wrap.appendChild(el("h2", {}, ["Famille & profil"]));

  const champFamille = el("div", { class: "field" }, [
    el("label", {}, ["Famille de profil"]),
    (() => {
      const sel = el("select", { onchange: (e) => {
        character.familleId = e.target.value || null;
        character.voiesProfilChoisies = [];
        character.formationsMartialesChoisies = [];
        character.talentMagiqueId = null;
        character.profilId = null;
        renderAll();
      } });
      sel.appendChild(el("option", { value: "" }, ["— Choisir —"]));
      Object.values(FAMILLES).forEach((f) => {
        const o = el("option", { value: f.id }, [f.nom]);
        if (character.familleId === f.id) o.setAttribute("selected", "selected");
        sel.appendChild(o);
      });
      return sel;
    })(),
  ]);
  wrap.appendChild(champFamille);

  if (character.familleId) {
    const famille = FAMILLES[character.familleId];
    wrap.appendChild(el("div", { class: "info-box" }, [
      `${famille.description} Dé de vie : d${famille.deVie}. Formations martiales : ${famille.formationsMartiales}.`,
    ]));

    // Profils suggérés
    const pres = Engine.resoudrePeuple(character);
    let cultureIdPourArchetype = null;
    if (pres) {
      if (character.peuple.mode === "simple") cultureIdPourArchetype = character.peuple.cultureId;
      else if (character.peuple.mode === "semi_elfe") cultureIdPourArchetype = "semi_elfe";
    }
    const suggestions = cultureIdPourArchetype ? profilsPour(cultureIdPourArchetype, character.familleId) : [];

    if (suggestions.length > 0) {
      wrap.appendChild(el("h3", {}, ["Profil(s) suggéré(s) pour cette culture"]));
      suggestions.forEach((p) => {
        const card = el("div", { class: "archetype-card" + (character.profilId === p.id ? " selected" : "") });
        card.appendChild(el("h4", {}, [p.nom]));
        card.appendChild(el("p", { class: "desc" }, [p.description]));
        card.appendChild(el("p", {}, [el("strong", {}, ["Voies de profil : "]), p.voies.map((v) => Engine.findVoieProfil(v).nom).join(", ")]));
        card.appendChild(el("p", {}, [el("strong", {}, ["Formations martiales : "]), p.formationsMartiales.map((c) => CATEGORIES_EQUIPEMENT.find((x) => x.id === c).nom).join(", ")]));
        if (p.talentMagique) card.appendChild(el("p", {}, [el("strong", {}, ["Talent magique : "]), TALENTS_MAGIQUES.find((t) => t.id === p.talentMagique).nom]));
        card.appendChild(el("button", { class: "btn", onclick: (ev) => {
          ev.stopPropagation();
          character.profilId = p.id;
          character.voiesProfilChoisies = [...p.voies];
          character.formationsMartialesChoisies = [...p.formationsMartiales];
          character.talentMagiqueId = p.talentMagique || null;
          renderAll();
        } }, ["Utiliser ce profil"]));
        wrap.appendChild(card);
      });
      wrap.appendChild(el("div", { class: "hint" }, ["Vous pouvez aussi personnaliser librement les voies de profil ci-dessous (règle optionnelle de personnalisation, p.45)."]));
    }

    wrap.appendChild(el("div", { class: "divider" }));
    wrap.appendChild(el("h3", {}, [`Voies de profil (choisir exactement 3 parmi les voies de la famille « ${famille.nom} »)`]));
    const voiesFamille = VOIES_PROFIL.filter((v) => v.famille === character.familleId);
    const grid = el("div", { class: "grid-3" });
    voiesFamille.forEach((v) => {
      const checked = character.voiesProfilChoisies.includes(v.id);
      const card = el("div", { class: "voie-card" + (checked ? " selected" : ""), onclick: () => {
        if (checked) {
          character.voiesProfilChoisies = character.voiesProfilChoisies.filter((x) => x !== v.id);
        } else if (character.voiesProfilChoisies.length < 3) {
          character.voiesProfilChoisies.push(v.id);
        }
        character.profilId = null; // personnalisation : on quitte l'archétype prédéfini
        renderAll();
      } });
      card.appendChild(el("h4", {}, [v.nom]));
      if (v.prerequis) card.appendChild(el("p", { class: "desc" }, [v.prerequis]));
      grid.appendChild(card);
    });
    wrap.appendChild(grid);
    wrap.appendChild(el("div", { class: "hint" }, [`${character.voiesProfilChoisies.length} / 3 voies sélectionnées.`]));

    wrap.appendChild(el("div", { class: "divider" }));
    wrap.appendChild(el("h3", {}, [`Formations martiales (choisir ${famille.formationsMartiales})`]));
    const gridFM = el("div", { class: "grid-3" });
    CATEGORIES_EQUIPEMENT.forEach((cat) => {
      const checked = character.formationsMartialesChoisies.includes(cat.id);
      const card = el("div", { class: "voie-card" + (checked ? " selected" : ""), onclick: () => {
        if (checked) {
          character.formationsMartialesChoisies = character.formationsMartialesChoisies.filter((x) => x !== cat.id);
        } else if (character.formationsMartialesChoisies.length < famille.formationsMartiales) {
          character.formationsMartialesChoisies.push(cat.id);
        }
        renderAll();
      } });
      card.appendChild(el("h4", {}, [cat.nom]));
      card.appendChild(el("p", { class: "desc" }, [cat.exemples]));
      gridFM.appendChild(card);
    });
    wrap.appendChild(gridFM);
    wrap.appendChild(el("div", { class: "hint" }, [`${character.formationsMartialesChoisies.length} / ${famille.formationsMartiales} formations sélectionnées. (Les armes de paysan sont toujours maîtrisées par tous les profils.)`]));

    if (famille.talentMagiqueRequis) {
      wrap.appendChild(el("div", { class: "divider" }));
      wrap.appendChild(el("h3", {}, ["Talent magique (offert aux mystiques)"]));
      const selTal = el("select", { onchange: (e) => { character.talentMagiqueId = e.target.value || null; renderAll(); } });
      selTal.appendChild(el("option", { value: "" }, ["— Choisir —"]));
      TALENTS_MAGIQUES.forEach((t) => {
        const o = el("option", { value: t.id }, [t.nom]);
        if (character.talentMagiqueId === t.id) o.setAttribute("selected", "selected");
        selTal.appendChild(o);
      });
      wrap.appendChild(selTal);
      const tal = character.talentMagiqueId ? TALENTS_MAGIQUES.find((t) => t.id === character.talentMagiqueId) : null;
      if (tal) wrap.appendChild(el("p", { class: "hint" }, [tal.texte]));
    }
  }

  const ok = character.familleId && character.voiesProfilChoisies.length === 3 && character.formationsMartialesChoisies.length === (FAMILLES[character.familleId] ? FAMILLES[character.familleId].formationsMartiales : 99) && (!FAMILLES[character.familleId] || !FAMILLES[character.familleId].talentMagiqueRequis || character.talentMagiqueId);

  wrap.appendChild(el("div", { class: "btn-row" }, [
    el("button", { class: "btn secondary", onclick: () => goStep("peuple") }, ["← Retour"]),
    el("button", { class: "btn", onclick: () => goStep("capacites"), disabled: !ok }, ["Continuer →"]),
  ]));
  return wrap;
}

/* ---------------------------------------------------------- */
/* Étape 4 — Capacités                                          */
/* ---------------------------------------------------------- */
function coutCumule(rang) {
  if (rang <= 0) return 0;
  if (rang === 1) return 1;
  if (rang === 2) return 2;
  if (rang === 3) return 4;
  if (rang === 4) return 6;
  return 8;
}

function budgetTotal(character) {
  return 2 * (character.niveau || 1);
}

function budgetDepense(character) {
  let total = 0;
  Object.values(character.progressionVoies || {}).forEach((rang) => { total += coutCumule(rang); });
  return total;
}

function renderSectionPV() {
  const famille = character.familleId ? FAMILLES[character.familleId] : null;
  const box = el("div", { class: "panel" });
  box.appendChild(el("h3", {}, ["Points de vie au-delà du niveau 1"]));
  if (!famille) {
    box.appendChild(el("div", { class: "hint" }, ["Choisissez d'abord une famille de profil (étape précédente) pour déterminer le dé de vie."]));
    return box;
  }
  box.appendChild(el("p", { class: "hint" }, [
    `Dé de vie de la famille « ${famille.nom} » : d${famille.deVie}. À chaque niveau au-delà du premier, le personnage gagne un jet de ce dé plus son Mod. de CON.`,
  ]));

  const champMethode = el("div", { class: "field" }, [
    el("label", {}, ["Méthode de calcul pour les niveaux 2 et suivants"]),
    (() => {
      const sel = el("select", { onchange: (e) => { character.methodePV = e.target.value; renderAll(); } });
      [
        { id: "moyenne", label: `Moitié du dé de vie (forfaitaire, ${Math.ceil(famille.deVie / 2)} par niveau)` },
        { id: "aleatoire", label: "Tirage aléatoire du dé de vie, géré par l'application" },
      ].forEach((m) => {
        const o = el("option", { value: m.id }, [m.label]);
        if (character.methodePV === m.id) o.setAttribute("selected", "selected");
        sel.appendChild(o);
      });
      return sel;
    })(),
  ]);
  box.appendChild(champMethode);

  if (character.methodePV === "aleatoire") {
    ensurePvRolls(character);
    box.appendChild(el("div", { class: "btn-row" }, [
      el("button", { class: "btn secondary", onclick: () => {
        character.pvRolls = character.pvRolls.map(() => rollerDV(famille.deVie));
        renderAll();
      } }, ["🎲 Relancer tous les jets"]),
    ]));
    const mods = Engine.modsFinaux(character);
    const table = el("div", {});
    for (let i = 0; i < character.niveau - 1; i++) {
      const niveauCourant = i + 2;
      const row = el("div", { class: "carac-row" });
      row.appendChild(el("div", { class: "nom" }, [`Niveau ${niveauCourant}`]));
      row.appendChild(el("div", { class: "mod" }, [`d${famille.deVie} = ${character.pvRolls[i]}`]));
      row.appendChild(el("div", { class: "mod" }, [`+ Mod. CON ${mods.CON >= 0 ? "+" : ""}${mods.CON}`]));
      row.appendChild(el("button", { class: "btn secondary", onclick: () => {
        character.pvRolls[i] = rollerDV(famille.deVie);
        renderAll();
      } }, ["Relancer"]));
      table.appendChild(row);
    }
    box.appendChild(table);
  }

  const s = Engine.statsSecondaires(character);
  box.appendChild(el("div", { class: "info-box" }, [
    `Points de vie totaux au niveau ${character.niveau} : ${s.pv} (dont ${s.deVie + s.modCON} au niveau 1, puis ${s.pv - s.deVie - s.modCON - s.pvBonus.total} cumulés sur les niveaux suivants${s.pvBonus.total ? `, et ${s.pvBonus.total} via les capacités acquises` : ""}).`,
  ]));
  return box;
}

function renderStepCapacites() {
  const wrap = el("div", { class: "panel" });
  wrap.appendChild(el("h2", {}, ["Capacités"]));

  const depart = Engine.voiesDeDepart(character);
  const auNiveau1 = character.niveau === 1;
  const budget = budgetTotal(character);
  const depense = budgetDepense(character);
  const restant = budget - depense;

  wrap.appendChild(el("div", { class: "info-box" }, [
    auNiveau1
      ? "Au niveau 1, choisissez exactement deux capacités de rang 1 parmi les cinq voies suivantes (trois voies de profil, une voie de peuple, une voie culturelle)."
      : `Points de capacité disponibles : ${restant} / ${budget} (2 par niveau). Les rangs 1 et 2 coûtent 1 point chacun, les rangs 3 à 5 coûtent 2 points chacun, et doivent être acquis dans l'ordre croissant.`,
  ]));
  if (!auNiveau1) {
    wrap.appendChild(el("div", { class: "hint" }, ["Au-delà du niveau 1, l'accès à de nouvelles voies dépend normalement des capacités déjà choisies (voie culturelle, voie de peuple, etc.). Cet outil vous laisse répartir librement les points sur l'ensemble des voies de profil ; validez la cohérence narrative avec votre MJ."]));
  }

  if (character.niveau > 1) {
    wrap.appendChild(el("div", { class: "divider" }));
    wrap.appendChild(renderSectionPV());
  }

  const voiesAffichees = auNiveau1 ? depart : Engine.toutesLesVoiesAvecRang(character);

  voiesAffichees.forEach((v) => {
    const rangActuel = (character.progressionVoies || {})[v.key] || 0;
    const box = el("div", { class: "panel", style: "margin-bottom:0.8rem;" });
    box.appendChild(el("h3", {}, [v.nom + (v.type ? ` (${v.type === "peuple" ? "voie de peuple" : v.type === "culturelle" ? "voie culturelle" : "voie de profil"})` : "")]));
    if (v.rangMax < 5) box.appendChild(el("div", { class: "hint" }, [`Rang maximum pour ce personnage : ${v.rangMax}.`]));

    v.rangs.forEach((capRang) => {
      const acquise = capRang.rang <= rangActuel;
      const rowClass = "capacite-rang" + (acquise ? " acquise" : " selectable");
      const peutAcheter = !acquise && capRang.rang === rangActuel + 1 && capRang.rang <= v.rangMax &&
        (auNiveau1 ? capRang.rang === 1 : true) &&
        (coutCumule(capRang.rang) - coutCumule(rangActuel)) <= restant + (auNiveau1 ? 0 : 0);
      const peutRetirer = acquise && capRang.rang === rangActuel;

      const row = el("div", { class: rowClass });
      const header = el("div", {});
      header.appendChild(el("span", { class: "rang-num" }, [`R${capRang.rang}`]));
      header.appendChild(el("span", { class: "nom-cap" }, [capRang.nom]));
      if (capRang.effets && capRang.effets.length) header.appendChild(el("span", { class: "effet-badge" }, ["calcul auto"]));
      row.appendChild(header);
      row.appendChild(el("div", { class: "txt" }, [capRang.texte]));

      const actions = el("div", { style: "margin-top:0.3rem;" });
      if (peutAcheter) {
        actions.appendChild(el("button", { class: "btn secondary", onclick: () => {
          character.progressionVoies[v.key] = capRang.rang;
          renderAll();
        } }, [auNiveau1 ? "Choisir (rang 1)" : `Acquérir (coût ${coutCumule(capRang.rang) - coutCumule(rangActuel)})`]));
      } else if (peutRetirer) {
        actions.appendChild(el("button", { class: "btn secondary", onclick: () => {
          character.progressionVoies[v.key] = rangActuel - 1;
          if (character.progressionVoies[v.key] <= 0) delete character.progressionVoies[v.key];
          renderAll();
        } }, ["Retirer"]));
      }
      row.appendChild(actions);
      box.appendChild(row);
    });
    wrap.appendChild(box);
  });

  if (auNiveau1) {
    wrap.appendChild(el("div", { class: depense === 2 ? "info-box" : "warning-box" }, [
      `Capacités de rang 1 choisies : ${depense} / 2.`,
    ]));
  }

  wrap.appendChild(el("div", { class: "btn-row" }, [
    el("button", { class: "btn secondary", onclick: () => goStep("profil") }, ["← Retour"]),
    el("button", { class: "btn", onclick: () => goStep("equipement"), disabled: auNiveau1 && depense !== 2 }, ["Continuer →"]),
  ]));
  return wrap;
}

